# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs
logs/
*.log

# Runtime data
runs/

# Environment
.env
.env.*

# User-specific environment config (API keys, credentials)
configs/environments/

# IDE specific files
steveX.code-workspace

# Vendored mod build/runtime artifacts (source is tracked; these are regenerable)
vendor/**/build/
vendor/**/.gradle/
vendor/**/run/

# Python tooling artifacts
__pycache__/
*.pyc

# Vendored DeepSeek Harness (src/agent/deepseek-harness-master)
# Entire subtree is tracked (~14000 files) because we modify it in-tree. Build
# artifacts and dependencies are ignored by the harness's own nested .gitignore,
# verified to cover: node_modules/ · lib/ · apps/web/dist/ · .env · .sessions/ ·
# .storages/ · dist-exe/ · *.tsbuildinfo · .pnpm-store/.
# Deliberately no path-level rules here: adding one would hide source we intend
# to edit. Upstream github.com/deepseek-ai/deepseek-harness, v0.2.0-rc.2.
# Upstream tracks the two desktop `.env.*.example` templates; the `.env.*` rule
# above would otherwise silently hide them.
!src/agent/deepseek-harness-master/apps/desktop/.env.*.example